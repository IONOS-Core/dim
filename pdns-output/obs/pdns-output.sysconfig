# /etc/sysconfig/pdns-output
# Sourced by /usr/sbin/pdns-output before starting the JVM.

# Path to the pdns-output properties file.
CONFIG_FILE=/etc/dim/pdns-output.properties

# Path to the log4j2 configuration file.
LOG4J2_CONFIG=/etc/dim/log4j2.properties

# Extra JVM flags (heap size, GC tuning, etc.).
JAVA_OPTS="-Xmx512m"
